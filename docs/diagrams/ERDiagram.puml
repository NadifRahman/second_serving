@startchen
left to right direction

' =========================
' Entities
' =========================

entity user_account {
    id : uuid <<key>>
    ' UUID will be generated by application code
    username
    full_name
    email
    created_at
}

entity food_listing {
    id <<key>>
    owner_id <<FK>>
    title
    description
    quantity
    ' quantity > 0
    quantity_unit
    ' will be an enum of possible units
    expires_at
    status
    ' this will be an ENUM of possible states
    ' available, finished, cancelled
    created_at
    updated_at
    ' maybe we can do images later
}

entity pickup_location {
    id <<key>>
    food_listing_id <<FK>>
    address
    ' Difficult to validate an address...
    ' will just trust user since its not what app will use
    location_point
    ' (PostGIS GEOGRAPHY(Point, 4326) in the DB) ?
    pickup_start_at
    pickup_end_at
    instructions
    created_at
    updated_at
}

' =========================
' Relationships
' =========================

relationship Owns {
}

Owns =N= food_listing
Owns -1- user_account


' We could make this a separate table or just
' or since its one to one we can just put in one table
relationship Has {
}

Has =1= food_listing
Has =1= pickup_location


relationship Reserved {
    quantity_requested
    status
    ' will be an enum of possible states
    ' requested, cancelled, collected
    requested_at
    confirmed_at
    cancelled_at
    completed_at
}

Reserved =(1, N)= food_listing
Reserved =(1, N)= user_account

@endchen