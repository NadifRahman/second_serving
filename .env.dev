# Spring
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
# Postgres
POSTGRES_DB=secondserving
POSTGRES_USER=secondserving
POSTGRES_PASSWORD=secondserving
POSTGRES_PORT=5432

# Vite/browser
# Vite only exposes variables prefixed with VITE_ to frontend code.
# Dev uses OpenFreeMap so the local app has a useful basemap without running
# the self-hosted tile service.
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron

# Empty keeps frontend API calls same-origin to Vite; vite.config.ts proxies
# `/api/*` to the Spring dev server.
VITE_API_BASE_URL=

# Toronto is the fallback center when browser geolocation is unavailable.
VITE_DEFAULT_LATITUDE=43.6532
VITE_DEFAULT_LONGITUDE=-79.3832
VITE_DEFAULT_RADIUS_METERS=50000
VITE_MAX_RADIUS_METERS=100000
