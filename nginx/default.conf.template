# Rate limiting
limit_req_zone $binary_remote_addr zone=api_limit:10m rate=10r/s;

server {
    # Redirect HTTP to HTTPS.
    listen 80;

    # Accept requests for any hostname for now.
    # TODO set this up once we got a hostname
    server_name _;

    return 301 https://$host$request_uri;
}

server {
    # Nginx listens on port 443 inside its container. Docker will map the host port.
    listen 443 ssl;

    # Accept requests for any hostname for now.
    # TODO set this up once we got a hostname
    server_name _;

    ssl_certificate /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;

    # Serve the built Vite app from the directory mounted by docker-compose.
    root /usr/share/nginx/html;
    index index.html;

    # Send backend API requests to the Spring Boot app on the Docker network.
    location /api/ {
        # Allow short bursts but throttle sustained traffic from one IP.
        limit_req zone=api_limit burst=20 nodelay;

        # Use the Compose service name and Spring's configured container port.
        proxy_pass http://app:${SERVER_PORT};
        proxy_http_version 1.1;

        # Preserve original request context for Spring logs and URL generation.
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Serve frontend assets normally; fall back to index.html for React Router.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
