# Production environment example

# Spring
SPRING_PROFILES_ACTIVE=prod
# Port Spring uses INSIDE the container or local development.
SERVER_PORT=8080
# Localhost-only VPS port for directly inspecting the Spring container.
APP_PORT=18080
JWT_SECRET=replace-with-a-long-random-base64-secret
JWT_EXPIRATION_MS=3600000
JWT_COOKIE_NAME=access_token
JWT_COOKIE_SECURE=true
JWT_COOKIE_SAME_SITE=Lax

# Postgres
POSTGRES_DB=secondserving
POSTGRES_USER=secondserving
POSTGRES_PASSWORD=replace-with-a-strong-password
# Port the VPS host publishes for the Postgres container, if exposed.
POSTGRES_PORT=5432


# Vite/browser
# Vite reads these values during `npm run build`, so changing them requires
# rebuilding the frontend bundle or Docker image.

# The map style, we will just use openfreemap even for prod.
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron

# Empty keeps API calls same-origin. Nginx/Spring should route `/api/*`.
VITE_API_BASE_URL=

# Toronto is the fallback center when browser geolocation is unavailable.
VITE_DEFAULT_LATITUDE=43.6532
VITE_DEFAULT_LONGITUDE=-79.3832
VITE_DEFAULT_RADIUS_METERS=50000
VITE_MAX_RADIUS_METERS=100000
